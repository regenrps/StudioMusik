# Jangan pernah memasukkan rahasia, data pengguna, atau artefak lokal ke image.
.git
.github
.idea
.vscode
.fleet
.phpunit.cache
.phpunit.result.cache
*.log

.env
.env.*
!.env.example

node_modules
vendor
public/build
public/hot

# Unggahan pengguna (foto, KTM/KTP, lampiran) — disimpan di volume, bukan di image.
public/storage/*
!public/storage/.htaccess
storage/app/private
storage/app/public
storage/app/.app_key
storage/app/.env.docker*
storage/app/.demo_seeded
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

Dockerfile
docker-compose*.yml
.dockerignore
