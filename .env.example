APP_NAME="Studio Musik ITERA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
# Kanal tumpukan: daily (berkas harian). Docker/server: daily,stderr
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Log akses HTTP (storage/logs/akses-*.log) & log keamanan (keamanan-*.log)
LOG_AKSES=true
LOG_AKSES_DAYS=30
LOG_KEAMANAN_DAYS=90
# Retensi jejak audit di tabel log_aktivitas (hari, 0 = selamanya)
LOG_RETENSI_AUDIT_HARI=365

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio_musik_new
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Produksi: gunakan "database" lalu jalankan `php artisan queue:work`
# agar email terkirim di latar belakang tanpa memperlambat halaman.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Bawaan otomatis true bila APP_URL https. Produksi: wajib true.
# SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------
# Keamanan
# ---------------------------------------------------------------
# Proxy tepercaya (reverse proxy / load balancer / tunnel): kosong, "*", atau daftar IP/CIDR.
# Port forwarding VS Code/devtunnels/ngrok butuh "*". Tanpa itu, CSS/JS dimuat dari
# http://localhost dan tampilan di URL tunnel menjadi berantakan.
TRUSTED_PROXIES=
# Content-Security-Policy: enforce | report | off
CSP_MODE=enforce

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengembangan: MAIL_MAILER=log (email ditulis ke storage/logs/laravel.log)
# Produksi (Gmail): MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_ENCRYPTION=tls, MAIL_PASSWORD diisi "App Password" Google (bukan sandi akun).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="musikitera@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Studio
# ---------------------------------------------------------------
STUDIO_NAMA="Studio Musik ITERA"
STUDIO_EMAIL=musikitera@gmail.com
# Nomor WhatsApp admin dalam format internasional tanpa "+"
STUDIO_WHATSAPP=6281271543205
# Username Instagram tanpa "@" (kosongkan untuk menyembunyikan)
STUDIO_INSTAGRAM=
STUDIO_MAPS_URL="https://maps.app.goo.gl/83vvmsvktTwXoemw8"
# Sinkronisasi status otomatis dari request web bila cron belum tersedia.
# Set ke false setelah scheduler (cron) aktif di server.
STUDIO_SINKRON_VIA_REQUEST=true
# Hapus foto KTM/KTP jaminan N hari setelah peminjaman berakhir (0 = simpan)
STUDIO_RETENSI_JAMINAN_HARI=30

# Akun admin pertama yang dibuat oleh `php artisan db:seed`
ADMIN_NAMA="Admin Studio"
ADMIN_EMAIL=musikitera@gmail.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
