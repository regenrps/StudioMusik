APP_NAME="Studio Musik ITERA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studio_musik_new
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Produksi: gunakan "database" lalu jalankan `php artisan queue:work`
# agar email terkirim di latar belakang tanpa memperlambat halaman.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengembangan: MAIL_MAILER=log (email ditulis ke storage/logs/laravel.log)
# Produksi (Gmail): MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_ENCRYPTION=tls, MAIL_PASSWORD diisi "App Password" Google (bukan sandi akun).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="musikitera@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Studio
# ---------------------------------------------------------------
STUDIO_NAMA="Studio Musik ITERA"
STUDIO_EMAIL=musikitera@gmail.com
# Nomor WhatsApp admin dalam format internasional tanpa "+"
STUDIO_WHATSAPP=6281271543205
# Username Instagram tanpa "@" (kosongkan untuk menyembunyikan)
STUDIO_INSTAGRAM=
STUDIO_MAPS_URL="https://www.google.com/maps/search/?api=1&query=Institut+Teknologi+Sumatera"
# Sinkronisasi status otomatis dari request web bila cron belum tersedia.
# Set ke false setelah scheduler (cron) aktif di server.
STUDIO_SINKRON_VIA_REQUEST=true

# Akun admin pertama yang dibuat oleh `php artisan db:seed`
ADMIN_NAMA="Admin Studio"
ADMIN_EMAIL=musikitera@gmail.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
